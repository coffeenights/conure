{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API Server",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/api-server",
      "args": ["runserver"],
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "Controller",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/control",
      "args": ["--development", "--log-level=1"],
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "API Server + Controller",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/api-server",
      "args": ["runserver"],
      "envFile": "${workspaceFolder}/.env",
      "presentation": { "hidden": true }
    }
  ],
  "compounds": [
    {
      "name": "API + Controller",
      "configurations": ["API Server", "Controller"],
      "stopAll": true
    }
  ]
}
